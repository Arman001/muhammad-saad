NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5433/chatapp

# Auth provider (Auth0). Keep the trailing slash on the issuer.
AUTH_ISSUER=https://YOUR_TENANT.us.auth0.com/
AUTH_AUDIENCE=https://chat-api

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Key required to call the health endpoint
HEALTH_API_KEY=change-me
