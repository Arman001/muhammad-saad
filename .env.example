NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://app:app@localhost:5433/chatapp

# Auth provider (Auth0). Must be HTTPS. Keep the trailing slash on the issuer.
AUTH_ISSUER=https://YOUR_TENANT.us.auth0.com/
AUTH_AUDIENCE=https://chat-api

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Key required to call the health endpoint (at least 16 characters)
HEALTH_API_KEY=replace-with-a-long-random-string

# Optional tuning (defaults shown)
REQUEST_TIMEOUT_MS=10000
BODY_LIMIT=10kb
NONCE_WINDOW_SECONDS=300
MOCK_AI_LATENCY_MS=800
PAYMENT_FAILURE_RATE=0.2
BILLING_CRON="*/5 * * * *"

# Reverse proxies in front of the app (0 when running directly)
TRUST_PROXY=0

# Rate limits per window (defaults shown)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_PER_IP=300
RATE_LIMIT_AUTH_PER_IP=30
RATE_LIMIT_AUTH_PER_USER=60
RATE_LIMIT_CHAT_PER_IP=60
RATE_LIMIT_CHAT_PER_USER=20
RATE_LIMIT_SUBSCRIPTIONS_PER_IP=60
RATE_LIMIT_SUBSCRIPTIONS_PER_USER=30

# Scheduled jobs (billing renewals, nonce cleanup)
JOBS_ENABLED=true
